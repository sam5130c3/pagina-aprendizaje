# ─────────────────────────────────────────────────────────────
# Copia este archivo como  .env  y reemplaza los valores.
# El archivo .env NO se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Campus virtual ──
# Dirección a la que lleva el botón "Campus virtual" del menú.
VITE_CAMPUS_URL=

# ── Registro e inicio de sesión (Supabase) ──
# Panel de Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Pasarela de pagos (ePayco) ──
# Panel de ePayco > Integraciones > Llaves API  ("PUBLIC_KEY")
# Esta llave es pública, puede ir en el navegador sin riesgo.
VITE_EPAYCO_PUBLIC_KEY=

# true  = modo pruebas, no se cobra dinero real (úsalo mientras desarrollas)
# false = cobros reales
VITE_EPAYCO_TEST=true

# (Opcional) URL de tu servidor que recibe la confirmación del pago.
# ePayco le avisa a esta dirección cuando una transacción cambia de estado.
VITE_EPAYCO_CONFIRMATION_URL=
